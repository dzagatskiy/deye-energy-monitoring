// Copy to Config/Secrets.xcconfig (git-ignored) to compile your own Deye developer keys into a personal build.
// Then the first-launch screen only asks for the Deye Cloud e-mail and password.
// Do NOT do this for a build you share with other people: anyone with the .ipa can extract the keys,
// and all users would share one API quota (see docs/deye-app-credentials.md).
DEYE_APP_ID = your_app_id
DEYE_APP_SECRET = your_app_secret
